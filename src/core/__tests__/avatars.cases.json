{
  "_about": "Profile pictures: eight presets, the same as BankingBook's, stored as their key. Anything else shows the fallback. Shared by the web, iPhone/Mac and Android tests.",
  "presets": ["Astro", "Bolt", "Camera", "Car", "Chess", "Coffee", "Game", "Rocket"],
  "fallback": "Astro",
  "toPreset": [
    { "value": "Rocket", "expect": "Rocket" },
    { "value": "Chess", "expect": "Chess" },
    { "value": "rocket", "expect": "Astro" },
    { "value": "default:3", "expect": "Astro" },
    { "value": "/9j/4AAQSkZJRg", "expect": "Astro" },
    { "value": "", "expect": "Astro" },
    { "value": null, "expect": "Astro" }
  ],
  "pick": [
    { "_note": "random in [0, 1) picks among the presets, skipping the one being replaced",
      "exclude": null, "random": 0.0, "expect": "Astro" },
    { "exclude": null, "random": 0.99, "expect": "Rocket" },
    { "exclude": "Astro", "random": 0.0, "expect": "Bolt" },
    { "exclude": "Chess", "random": 0.5, "expect": "Car" },
    { "exclude": "Rocket", "random": 0.99, "expect": "Game" },
    { "exclude": "default:2", "random": 0.2, "expect": "Bolt" }
  ]
}
